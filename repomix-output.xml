@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
@import "tailwindcss";

body {
  background-color: #FAF7F2;
  color: #1e293b;
  font-family: 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* Custom animations for Yada spiritual particle background */
@keyframes stardust {
  0% {
    transform: translateY(0px) scale(1);
    opacity: 0.3;
  }
  50% {
    transform: translateY(-15px) scale(1.2);
    opacity: 0.8;
  }
  100% {
    transform: translateY(-30px) scale(1);
    opacity: 0.2;
  }
}

.animate-stardust {
  animation: stardust 6s ease-in-out infinite alternate;
}

/* Breathing / living pulse animation for logo */
@keyframes breathe {
  0%   { transform: scale(1);    opacity: 1; }
  40%  { transform: scale(1.12); opacity: 0.85; }
  60%  { transform: scale(1.12); opacity: 0.85; }
  100% { transform: scale(1);    opacity: 1; }
}

.animate-breathe {
  animation: breathe 3.2s ease-in-out infinite;
}

@keyframes landing-cover-scroll {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(calc(-50% - 0.375rem));
  }
}

.landing-cover-track {
  width: max-content;
  animation: landing-cover-scroll 122s linear infinite;
  will-change: transform;
}

.landing-cover-card {
  aspect-ratio: 2 / 3;
  animation: landing-cover-pop 7.5s ease-in-out infinite;
  will-change: transform;
  z-index: 1;
}

.landing-cover-card:hover,
.landing-cover-card:focus-visible {
  animation-play-state: paused;
  transform: translateY(-8px) scale(1.08);
  z-index: 20;
}

@keyframes landing-cover-pop {
  0%, 74%, 100% {
    transform: translateY(0) scale(1);
    z-index: 1;
  }
  82%, 90% {
    transform: translateY(-5px) scale(1.06);
    z-index: 8;
  }
}

.landing-cover-track:hover {
  animation-play-state: paused;
}

.landing-cover-scroller {
  scrollbar-width: none;
  -ms-overflow-style: none;
  touch-action: pan-x;
  overscroll-behavior-x: contain;
  cursor: grab;
}

.landing-prompt-panel {
  isolation: isolate;
}

@media (max-width: 639px) {
  .landing-prompt-panel {
    width: min(92vw, 390px);
  }
}

button:focus-visible,
[role="button"]:focus-visible,
textarea:focus-visible {
  outline: 2px solid #38bdf8;
  outline-offset: 3px;
}

.landing-cover-scroller::-webkit-scrollbar {
  display: none;
}

.landing-cover-scroller:active {
  cursor: grabbing;
}

/* The featured chat cards stay compact so the demo input remains the focal point. */
.gnosis-slide-card {
  width: min(72%, 260px);
  height: 76%;
  max-height: 225px;
  border-radius: 14px;
  padding: 7px 9px;
}

@media (min-width: 640px) {
  .gnosis-slide-card {
    width: min(64%, 350px);
    height: 72%;
    max-height: 290px;
    border-radius: 16px;
    padding: 9px 11px;
  }
}

@media (min-width: 1024px) {
  .gnosis-slide-card {
    width: min(58%, 390px);
    height: 70%;
    max-height: 320px;
    padding: 10px 12px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .landing-cover-track,
  .landing-cover-card {
    animation: none;
    transform: translateX(0);
  }
}

/* Scrollbar styling */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: #e2e8f0;
  border-radius: 9999px;
}

::-webkit-scrollbar-thumb:hover {
  background: #cbd5e1;
}
