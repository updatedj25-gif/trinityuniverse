    if (pointerStartX.current === null) return;
    const dx = e.clientX - pointerStartX.current;
    if (Math.abs(dx) > 35) {
      wasDragged.current = true;
      if (dx < 0) goNext();
      else goPrev();
    }
    pointerStartX.current = null;
