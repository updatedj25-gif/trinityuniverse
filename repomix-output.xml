@Composable
fun ModelSelectorPills(
    selectedPill: String,
    onPillSelected: (String) -> Unit,
    modifier: Modifier = Modifier
) {
    val pills = listOf(
        Triple("Instant", "✨", Color(0xFFF59E0B)),
        Triple("Expert", "💎", Color(0xFF3B82F6)),
        Triple("Vision", "👁️", Color(0xFF8B5CF6))
